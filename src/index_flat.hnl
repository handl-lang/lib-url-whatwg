slen := (xs) ~> do { n := 0; for _ in xs { do { n := n + 1 } }; n }
take := (xs, n) ~> do { out := []; i := 0; for x in xs { do { if i < n { do { out := [...out, x] } } else { do {} }; i := i + 1 } }; out }
drop := (xs, n) ~> do { out := []; i := 0; for x in xs { do { if i >= n { do { out := [...out, x] } } else { do {} }; i := i + 1 } }; out }
s_slice := (s, i, n) ~> char.from_chars(take(drop(char.chars(s), i), n))
s_len := (s) ~> slen(char.chars(s))

--- `url_whatwg.parse` — strict RFC 3986 URI parser, pure handl.

--- index of first occurrence of any of chars `cs` in `s`, else -1.
first_of := (s, cs) ~> do {
  idx := -1
  i := 0
  for c in char.chars(s) { do {
    if idx < 0 && str.find(cs, c) >= 0 { do { idx := i } } else { do {} }
    i := i + 1
  } }
  idx
}
--- last index of `c` in `s`, else -1.
last_of := (s, c) ~> do {
  idx := -1
  i := 0
  for ch in char.chars(s) { do {
    if ch == c { do { idx := i } } else { do {} }
    i := i + 1
  } }
  idx
}
head_to := (s, i) ~> s_slice(s, 0, i)
tail_from := (s, i) ~> s_slice(s, i, s_len(s) - i)

url_whatwg_parse_impl := (s) ~> do {
  rest := s
  scheme := ""
  authority := ""
  userinfo := ""
  host := ""
  port := ""
  path := ""
  query := ""
  fragment := ""
  -- scheme
  ci := first_of(rest, ":")
  if ci > 0 { do {
    scheme := head_to(rest, ci)
    rest := tail_from(rest, ci + 1)
  } } else { do {} }
  -- //authority
  if s_len(rest) >= 2 && s_slice(rest, 0, 2) == "//" { do {
    rest := tail_from(rest, 2)
    ai := first_of(rest, "/?#")
    if ai < 0 { do { ai := s_len(rest) } } else { do {} }
    authority := head_to(rest, ai)
    rest := tail_from(rest, ai)
  } } else { do {} }
  -- userinfo
  ui := last_of(authority, "@")
  if ui >= 0 { do {
    userinfo := head_to(authority, ui)
    authority := tail_from(authority, ui + 1)
  } } else { do {} }
  -- host:port
  pi := last_of(authority, ":")
  if pi >= 0 { do {
    host := head_to(authority, pi)
    port := tail_from(authority, pi + 1)
  } } else { do { host := authority } }
  -- fragment
  fi := first_of(rest, "#")
  if fi >= 0 { do {
    fragment := tail_from(rest, fi + 1)
    rest := head_to(rest, fi)
  } } else { do {} }
  -- query
  qi := first_of(rest, "?")
  if qi >= 0 { do {
    query := tail_from(rest, qi + 1)
    rest := head_to(rest, qi)
  } } else { do {} }
  path := rest
  { scheme: scheme, authority: authority, userinfo: userinfo, host: host,
    port: port, path: path, query: query, fragment: fragment }
}

--- url_whatwg.parse -- parse a WHATWG URL Standard string into a Value.
--- url_whatwg.url_whatwg -- return the parser token for url_whatwg.
cap "url_whatwg.parse"
cap "url_whatwg.url_whatwg"
op "url_whatwg.parse" : String -> Value
  guarantee: True
op "url_whatwg.url_whatwg" : () -> Value
  guarantee: True

handle "url_whatwg.parse" with rust_url_whatwg_parse
handle "url_whatwg.url_whatwg" with rust_url_whatwg_name

--- pure-handl impl:

export parse := url_whatwg_parse_impl
export url_whatwg := () ~> ({ "type": "parser", "name": "url_whatwg", "parse": url_whatwg_parse_impl })
